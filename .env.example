# Copy to .env and fill in. Never commit .env.

# --- Option A: OpenAI API (preferred when billing is available) ---
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-5.6
# (leave OPENAI_BASE_URL unset)

# --- Option B: Gemini free tier via OpenAI-compatible endpoint ---
# Get a free key at https://aistudio.google.com (no card required).
OPENAI_API_KEY=your-gemini-key-here
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-2.5-flash

SIKA_DB=data/processed/sika.db

# Trust Core is separate from the MVP DB. Alembic does not load .env: export this
# variable in your shell explicitly when running migrations (see DATA_SPEC_V2.md).
# SIKA_DATABASE_URL=sqlite:///data/processed/sika_v2.db

# S0.4.2 local administrative CLI only: export this in the operator's shell.
# Resolve your OS principal with: python -m sika.review identity
# Empty/unset means no operator may approve or publish. Do not use a display name.
# This is not SaaS authentication; no public route consumes this setting.
# SIKA_REVIEWER_IDS=windows:<verified-SID>
